# C-STAR — live server settings (cPanel). Copy to cstar-app/.env and fill in every CHANGE-ME.
# Guide: docs/C-STAR-Deployment-BN.md. Never upload or share the real .env — it holds the passwords.

APP_NAME="C-STAR"
APP_ENV=production
APP_DEBUG=false
# Left empty on purpose: "php artisan cstar:deploy" creates it on the first run. Keep a copy of the .env safe.
APP_KEY=
APP_URL=https://CHANGE-ME.example.com
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# cPanel → MySQL Databases: create the database and user, give the user ALL PRIVILEGES.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE-ME_cstar
DB_USERNAME=CHANGE-ME_cstar
DB_PASSWORD=CHANGE-ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Same host as APP_URL, without https:// (add "www." too if the site answers on both).
SANCTUM_STATEFUL_DOMAINS=CHANGE-ME.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# cPanel → Email Accounts: e.g. noreply@your-domain. Port 465 with "ssl" is the usual cPanel set-up.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.CHANGE-ME.example.com
MAIL_PORT=465
MAIL_USERNAME=noreply@CHANGE-ME.example.com
MAIL_PASSWORD=CHANGE-ME
MAIL_FROM_ADDRESS="noreply@CHANGE-ME.example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
